# Security Council Member Configuration
# Option 1: Add your agent wallet private key here to access Security Council features
MAINNET_PRIVATE_KEY=
HOLESKY_PRIVATE_KEY=

# Option 2: Use a hardware wallet via Frame (https://frame.sh)
# Install Frame, connect your Ledger/Trezor, and the CLI will detect it automatically.
# You can also force hardware wallet usage with: --wallet frame

# IPFS Configuration
# For reading IPFS content (defaults to rotating gateway list if not set)
# IPFS_GATEWAY=https://ipfs.io/ipfs

# For pinning/uploading proposal metadata to IPFS
# Required for creating proposals
# Sign up for free at https://pinata.cloud
# Go to API Keys section and generate a JWT (JSON Web Token)
PINATA_JWT=